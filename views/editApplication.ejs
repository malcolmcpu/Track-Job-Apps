<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Edit Your Application</title>
  </head>
  <body class="background">
    <h1>Edit Your Application</h1>

    <form method="POST" action="/applications/<%= application._id %>">
      <label for="company">Company</label>
      <input id="company" name="company" type="text" required value="<%= application.company %>">

      <label for="role">Role</label>
      <input id="role" name="role" type="text" required value="<%= application.role %>">

      <label for="status">Status</label>
      <select id="status" name="status">
        <% statuses.forEach(s => { %>
          <option value="<%= s %>" <%= application.status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>

      <label for="dateApplied">Date applied</label>
      <input id="dateApplied" name="dateApplied" type="date"
             value="<%= application.dateApplied ? application.dateApplied.toISOString().slice(0, 10) : '' %>">

      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="5"><%= application.notes || '' %></textarea>

      <button type="submit">Save</button>
      <a href="/applications">Cancel</a>
    </form>
  </body>
</html>
